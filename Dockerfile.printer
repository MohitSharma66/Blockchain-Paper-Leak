FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir web3 cryptography requests
COPY printer-agent /app/printer-agent
COPY backend/contract_deployment.json /app/backend/contract_deployment.json
COPY scripts/printer-container-entrypoint.sh /app/scripts/printer-container-entrypoint.sh
RUN chmod 755 /app/scripts/printer-container-entrypoint.sh && mkdir -p /app/printer-agent/devices /app/printer-agent/enrollments
WORKDIR /app/printer-agent
ENTRYPOINT ["/app/scripts/printer-container-entrypoint.sh"]
